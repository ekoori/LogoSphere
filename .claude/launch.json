{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000,
      "autoPort": false,
      "cwd": "frontend",
      "env": { "BROWSER": "none" }
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["run_local.py"],
      "port": 5000,
      "autoPort": false,
      "cwd": "backend",
      "env": { "CASSANDRA_HOST": "127.0.0.1", "PYTHONPATH": "." }
    }
  ]
}
